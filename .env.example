# 백엔드 서버 URL (예: http://서버주소:포트/api/v1)
NEXT_PUBLIC_API_URL=
# 서버 사이드 REST / Socket.IO 프록시 대상 (로컬·배포 모두 통화 소켓에 사용)
BACKEND_URL=http://localhost:8080
# 기본 proxy: 같은 origin의 /socket.io를 통해 BFF로 연결 (CORS 설정 불필요).
NEXT_PUBLIC_WEBRTC_CONNECTION_MODE=proxy
# direct 모드에서만 사용. 서버 Socket.IO의 CORS 허용 설정이 필요함.
# /calls namespace까지 포함하며 HTTPS 페이지에서는 TLS 주소 사용.
NEXT_PUBLIC_WEBRTC_WS_URL=
NEXT_PUBLIC_WEBRTC_SOCKET_PATH=/socket.io
# 수어 자막은 BFF /calls의 send_frame / frame_translation을 사용.
# STT는 AI에 직접 연결하여 MediaRecorder 바이너리(WebM/Opus 우선)를 전송.
NEXT_PUBLIC_STT_WS_URL=wss://gesture.ingyuc.click/cc_stt
